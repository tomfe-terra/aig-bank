DEBUG=false 
HOST=127.0.0.1
PORT=8000
DATABASE_URL="sqlite+aiosqlite:///./bank.db"

JWT_SECRET_KEY="your-jwt-secret-key-here-change-this-in-production"
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

AES_KEY="your-32-byte-aes-key-in-hex-format-here"
HMAC_KEY="your-32-byte-hmac-key-in-hex-format-here"

LOG_LEVEL="INFO"
LOGS_DIRECTORY="logs"

DOCS_VERBOSITY=FULL
REPAYMENT_CHECK_INTERVAL_SECONDS=3600
