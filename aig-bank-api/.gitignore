# =====================================
# FastAPI Banking API - Only What's Generated
# =====================================

# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Build / packaging
build/
dist/
.eggs/
*.egg-info/

# Virtual environments
.venv/
venv/
ENV/

# SQLite database files (generated by the application)
*.db
*.db-shm
*.db-wal

# Log files (generated by the application)
logs/
*.log

# Test coverage reports (generated by pytest --cov)
htmlcov/
.coverage

# Pytest cache (generated by pytest)
.pytest_cache/

# MyPy cache (generated by mypy)
.mypy_cache/

# IDE files (if using VS Code or PyCharm)
.vscode/
.idea/

# macOS files (if using macOS)
.DS_Store

.env
.env.local
.env.test