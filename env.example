# =============================================================================
# AIG Bank Docker Compose Configuration
# =============================================================================
# Copy this file to .env and configure the values below
# For production use, generate secure random values for all secrets

# -----------------------------------------------------------------------------
# Domain Configuration
# -----------------------------------------------------------------------------
# Main domain for all services (without protocol or subdomain)
# All services will be available at subdomains:
#   - https://app.${DOMAIN}  (Vue.js frontend)
#   - https://api.${DOMAIN}  (FastAPI backend)
#   - https://pay.${DOMAIN}  (Payment gateway)
#
# For production: DOMAIN=bank.example.com
# For local dev:  DOMAIN=localhost
#   (requires /etc/hosts entries: 127.0.0.1 app.localhost api.localhost pay.localhost)
DOMAIN=localhost

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=bankuser
POSTGRES_PASSWORD=change_this_secure_password_in_production
POSTGRES_DB=bankdb

# -----------------------------------------------------------------------------
# API Security Keys (REQUIRED - Generate secure random values!)
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Or with:       openssl rand -base64 32

# JWT signing key (for authentication tokens)
JWT_SECRET_KEY=change_this_jwt_secret_key_to_secure_random_value

# AES encryption key for PAN storage (32 bytes hex)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AES_KEY=change_this_aes_key_to_secure_random_hex_64_chars

# HMAC key for PAN fingerprinting (32 bytes hex)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_KEY=change_this_hmac_key_to_secure_random_hex_64_chars

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# JWT Token Configuration
# -----------------------------------------------------------------------------
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# 1. SSL Certificates:
#    - Place cert.pem and key.pem in ./certs/ directory
#    - For production: use wildcard cert for *.${DOMAIN}
#    - For development: generate self-signed cert with SANs for all subdomains
#
# 2. CORS Origins:
#    - Automatically configured as https://app.${DOMAIN} and https://api.${DOMAIN}
#    - No need to manually configure CORS_ORIGINS
#
# 3. Database URL:
#    - Automatically constructed from POSTGRES_* variables
#    - Uses internal Docker network DNS (postgres:5432)
#
# 4. Starting the services:
#    - docker compose up -d
#
# 5. Stopping the services:
#    - docker compose down
#
# 6. Viewing logs:
#    - docker compose logs -f [service_name]

